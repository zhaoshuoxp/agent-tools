    },
    {
      "name": "ssh-shortcut",
      "source": {
        "source": "local",
        "path": "./packages/ssh-connections-local/plugins/ssh-shortcut"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Productivity"
    }
  ]
}
